# Application
APP_NAME=brand-qa-agent
ENVIRONMENT=development
LOG_LEVEL=INFO

# Extraction (LangChain WebBaseLoader - only URL fetch path)
WEB_LOADER_TIMEOUT_MS=30000
WEB_USER_AGENT=brand-qa-agent/0.1
MIN_CONTENT_LENGTH=200

# Embeddings (Ollama: qwen3-embedding:4b)
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSION=1024
OLLAMA_BASE_URL=http://localhost:11434

# Chunking (character-based length, no external tokenizer)
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Pinecone (serverless, hybrid dense + BM25 sparse index)
PINECONE_API_KEY=
PINECONE_INDEX=brand-chunks
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_ALPHA=0.5

# Reranking (cross-encoder/ms-marco-MiniLM-L6-v2, CPU-friendly, ~80MB first run)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_DEVICE=cpu

# Retrieval
HYBRID_TOP_K=10
FINAL_TOP_K=5

# LLM (Groq primary; OpenAI / OpenAI-compatible endpoint as fallback)
# Provide GROQ_API_KEY, or OPENAI_API_KEY (optionally with OPENAI_BASE_URL).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_STRUCTURED_OUTPUT_METHOD=json_schema
TEMPERATURE=0.0